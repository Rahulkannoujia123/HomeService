{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Publish HomeService to GitHub",
			"type": "shell",
			"command": "git",
			"args": [
				"init",
				"&&",
				"git",
				"add",
				".",
				"&&",
				"git",
				"commit",
				"-m",
				"first commit",
				"&&",
				"git",
				"branch",
				"-M",
				"main",
				"&&",
				"git",
				"remote",
				"add",
				"origin",
				"https://github.com/Rahulkannoujia123/HomeService.git",
				"&&",
				"git",
				"push",
				"-u",
				"origin",
				"main"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Publish HomeService to GitHub PowerShell",
			"type": "shell",
			"command": "git init; git add .; git commit -m 'first commit'; git branch -M main; git remote remove origin 2>$null; git remote add origin https://github.com/Rahulkannoujia123/HomeService.git; git push -u origin main",
			"isBackground": false,
			"problemMatcher": []
		}
	]
}